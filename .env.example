# ---- Auth ----
# The single shared password both players use to enter the game.
GAME_PASSWORD=change-me

# Secret used to sign the auth cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-long-random-secret

# ---- Persistence ----
# The app auto-detects a backend from the variables below. Pick ONE.
#
# Option A — Vercel Edge Config (global config store).
#   * EDGE_CONFIG is injected automatically when you connect an Edge Config
#     store to the project in the Vercel dashboard. It is READ-ONLY.
#   * Writes go through the Vercel REST API, so you MUST also provide a Vercel
#     API token (Account Settings -> Tokens) with access to the store.
#   * VERCEL_TEAM_ID is only needed if the store belongs to a Vercel team.
EDGE_CONFIG=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# EDGE_CONFIG_ID=            # optional; parsed from EDGE_CONFIG if omitted

# Option B — Vercel KV / Upstash Redis (also fine). KV_* or UPSTASH_* both work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# If none of the above are set, the app falls back to in-memory storage
# (great for local dev; resets on restart / cold start).
