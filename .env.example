# ---- Auth ----
# The single shared password both players use to enter the game.
GAME_PASSWORD=change-me

# Secret used to sign the auth cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-long-random-secret

# ---- Persistence (optional for local dev, required for real Vercel deploys) ----
# Create a free Upstash Redis DB (or add Vercel KV) and paste the REST creds here.
# The app auto-detects either KV_* (Vercel KV) or UPSTASH_* variable names.
# Without these, the app falls back to in-memory storage (fine locally, resets on Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=
